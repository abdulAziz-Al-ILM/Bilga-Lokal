{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Bilga: Android doctor",
      "type": "shell",
      "command": "source tool/android_env.sh && flutter doctor -v",
      "options": { "shell": { "executable": "/bin/bash", "args": ["-c"] } },
      "problemMatcher": []
    },
    {
      "label": "Bilga: debug APK",
      "type": "shell",
      "command": "source tool/android_env.sh && flutter build apk --debug && bash tool/verify_android_apk.sh",
      "options": { "shell": { "executable": "/bin/bash", "args": ["-c"] } },
      "group": "build",
      "problemMatcher": []
    }
  ]
}

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notes_widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="10dp" android:background="#142019">
    <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:gravity="center_vertical">
        <TextView android:id="@+id/notes_widget_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
            android:gravity="center_vertical" android:text="@string/nw_notes" android:textColor="#EEEEEE" android:textStyle="bold" android:textSize="16sp" android:maxLines="1" android:ellipsize="end"/>
        <TextView android:id="@+id/notes_widget_add" android:layout_width="36dp" android:layout_height="match_parent"
            android:gravity="center" android:text="+" android:textSize="25sp" android:textColor="#A4D7B9" android:contentDescription="@string/nw_new_note"/>
        <TextView android:id="@+id/notes_widget_search" android:layout_width="36dp" android:layout_height="match_parent"
            android:gravity="center" android:text="⌕" android:textSize="25sp" android:textColor="#A4D7B9" android:contentDescription="@string/nw_search"/>
        <TextView android:id="@+id/notes_widget_settings" android:layout_width="36dp" android:layout_height="match_parent"
            android:gravity="center" android:text="⚙" android:textSize="22sp" android:textColor="#A4D7B9" android:contentDescription="@string/nw_settings"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/notes_widget_rows" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
    <TextView android:id="@+id/notes_widget_message" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/nw_hidden" android:textColor="#EEEEEE" android:textSize="13sp" android:paddingTop="8dp" android:maxLines="2" android:ellipsize="end"/>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notes_widget_note_row" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:minHeight="40dp" android:paddingTop="6dp" android:paddingBottom="6dp">
    <TextView android:id="@+id/notes_widget_note_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="14sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end"/>
    <TextView android:id="@+id/notes_widget_note_body" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="12sp" android:maxLines="3" android:ellipsize="end"/>
    <TextView android:id="@+id/notes_widget_note_tags" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="11sp" android:maxLines="1" android:ellipsize="end"/>
</LinearLayout>

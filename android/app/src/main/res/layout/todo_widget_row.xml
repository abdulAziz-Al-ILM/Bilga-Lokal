<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="4dp">
 <ImageView android:id="@+id/todo_widget_row_background" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:importantForAccessibility="no"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:padding="7dp">
  <LinearLayout android:id="@+id/todo_widget_row_text" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:minHeight="32dp" android:gravity="center_vertical">
   <TextView android:id="@+id/todo_widget_row_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#EEEEEE" android:textSize="14sp" android:maxLines="2" android:ellipsize="end"/>
   <TextView android:id="@+id/todo_widget_row_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#EEEEEE" android:textSize="11sp" android:maxLines="2" android:ellipsize="end"/>
   <Chronometer android:id="@+id/todo_widget_row_remaining" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp"/>
  </LinearLayout>
  <TextView android:id="@+id/todo_widget_row_snooze" android:layout_width="48dp" android:layout_height="48dp" android:gravity="center" android:text="◷" android:textSize="24sp"/>
  <TextView android:id="@+id/todo_widget_row_done" android:layout_width="48dp" android:layout_height="48dp" android:gravity="center" android:text="□" android:textSize="24sp" android:textColor="#EEEEEE" android:contentDescription="@string/tw_done"/>
 </LinearLayout>
</FrameLayout>
